{
  "title": "Churn Model Training Metrics",
  "uid": "churn-training",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "PR-AUC (mean ± std)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.60 },
              { "color": "green", "value": 0.70 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_pr_auc_mean",
          "legendFormat": "PR-AUC mean",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "title": "ROC-AUC (mean)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_roc_auc_mean",
          "legendFormat": "ROC-AUC mean",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "F1 Score (mean)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.55 },
              { "color": "green", "value": 0.65 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_f1_mean",
          "legendFormat": "F1 mean",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Accuracy (mean)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "green", "value": 0.80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_accuracy_mean",
          "legendFormat": "Accuracy mean",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "Precision & Recall (mean)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.65 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_precision_mean",
          "legendFormat": "Precision",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "churn_train_recall_mean",
          "legendFormat": "Recall",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Metric Std Dev (CV stability)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "min": 0, "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.03 },
              { "color": "red", "value": 0.06 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "churn_train_pr_auc_std",
          "legendFormat": "PR-AUC std",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "churn_train_f1_std",
          "legendFormat": "F1 std",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "churn_train_roc_auc_std",
          "legendFormat": "ROC-AUC std",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}
